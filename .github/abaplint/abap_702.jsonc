{
  "global": {
    "files": "/../../src/**/*.*",
    // src/zz_dev is the gitignored dev sandbox the MCP server deploys into -
    // excluded here exactly like in the root abaplint.jsonc, so a local run
    // with a populated sandbox matches what CI lints from a clean checkout
    "exclude": ["zz_dev"]
  },
  "dependencies": [
    {
      "url": "https://github.com/open-abap/open-abap-core",
      "folder": "/deps",
      "files": "/src/**/*.*"
    },
    {
      "url": "https://github.com/abap2UI5/abap2UI5",
      // the 702 build resolves the framework against its downported branch,
      // which the framework's own auto_downport rebuilds from main
      "branch": "702",
      "folder": "/abap2UI5",
      "files": "/src/**/*.*"
    }
  ],
  "syntax": {
    "version": "v702",
    "errorNamespace": "."
  },
  "rules": {
    "downport": true,
    "definitions_top": true,
    "begin_end_names": true,
    "check_ddic": true,
    "check_include": true,
    "check_syntax": true,
    "global_class": true,
    "implement_methods": true,
    // the 7.02 editor stores 255 characters a line and cuts the rest on
    // import - a cut literal fails activation ("Literals that take up more
    // than one line are not permitted", #3048; the framework's #2947). The
    // root abaplint.jsonc checks this on main, but the downport is what MAKES
    // such lines: it joins a multi-line && chain inside a VALUE #( ) row into
    // one line, so only a check on the downported tree can see them
    "line_length": {
      "length": 255
    },
    "method_implemented_twice": true,
    "parser_error": true,
    "superclass_final": true,
    "unknown_types": true,
    "xml_consistency": true
  }
}
